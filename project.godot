;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="tommies-vs-aliens"
run/main_scene="res://features/levels/barracks/barracks.tscn"
